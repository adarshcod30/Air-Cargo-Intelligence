# Air Cargo Intelligence - runtime configuration.
#
# Loaded automatically by services/common/config.py, so no entry point
# needs this file exported first. Real environment variables always take
# precedence: a hosted deployment sets them directly and has no .env, and
# a stale local file must never override what the platform supplies.
#
# This file is gitignored. Never commit it.

# ---- Database -------------------------------------------------------------
# Points at the managed database, so the same values work locally and on any
# host. Use the POOLED endpoint for anything serverless: each invocation is a
# fresh connection and a direct endpoint runs out of them.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/air_cargo?sslmode=require

# The serving connection. Holds SELECT on the allowlisted views and no rights
# at all on the tables beneath them, so a query that escaped the semantic
# layer still could not read an unaudited row or write anything.
DATABASE_URL_READONLY=postgresql+psycopg://aci_readonly:PASSWORD@HOST/air_cargo?sslmode=require

# Local Postgres instead, when you want to run the full ingest and analytics
# without pushing load at the managed instance. Requires a local server with
# the migrations applied - see the README.
# DATABASE_URL=postgresql+psycopg://adarsh@localhost:5432/air_cargo
# DATABASE_URL_READONLY=postgresql+psycopg://aci_readonly:CHANGE_ME@localhost:5432/air_cargo

# ---- Reasoning layer (AWS Bedrock) ----------------------------------------
# The agents' policy layer and the narrative agent both run through the
# Converse API, which normalises the request shape across model families -
# so changing the model id is a config change, not a code change.
#
# Credentials are read by boto3 from these standard variables and never pass
# through application config. Leave them blank and everything still runs: the
# agents fall back to the deterministic policy and narratives fall back to a
# template. The trace records which policy actually decided each step, so a
# fallback shows as heuristic(fallback:no-credentials) rather than being
# reported as model judgement.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_ENABLED=true
# Nova Lite: the policy loop makes one short structured call per step, and a
# larger model costs more without choosing better tools. The A/B harness
# measures whether that holds rather than assuming it.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_FAST_MODEL_ID=us.amazon.nova-micro-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- Retrieval ------------------------------------------------------------
# Hybrid passage search over the ingested documents: pgvector for dense
# similarity, Postgres full text for rare terms, fused on rank. With Bedrock
# reachable the index is built with Titan embeddings; without it an offline
# hashed TF-IDF embedder is used. The two are not comparable, so the model
# that produced each vector is stored and the retriever refuses to mix them.
# Re-index after adding credentials: python -m services.rag.index --rebuild
RAG_ENABLED=true
RAG_TOP_K=5

# ---- Open Government Data platform (data.gov.in) --------------------------
# One key covers every dataset; datasets are addressed by resource_id.
# Register free at https://www.data.gov.in/user/register.
# This key travels in the query string, which is why source URLs are redacted
# before they reach logs, the provenance ledger or an agent trace.
DATA_GOV_IN_API_KEY=

# ---- Agent and ingestion tuning -------------------------------------------
# Step budget per agent run. The loop also stops early on a repeated
# identical failure, so this is a ceiling rather than a target.
ACI_AGENT_MAX_STEPS=12
# Extractions below this confidence are quarantined for review, not loaded.
ACI_CONFIDENCE_FLOOR=0.60
ACI_REQUEST_TIMEOUT=60
ACI_MAX_RETRIES=3
# Seconds between requests to one publisher. Two concurrent crawls is
# precisely how this project got rate limited once already.
ACI_POLITE_DELAY=0.5

LOG_LEVEL=INFO

# ---- Self-hosted model (optional alternative to Bedrock) ------------------
# Any OpenAI-compatible endpoint, used only when Bedrock is unavailable.
# For a fully local setup point this at Ollama and leave the key blank.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
