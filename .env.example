# ---- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://cargo:cargo@localhost:5432/air_cargo

# ---- Cache & task broker --------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Language model -------------------------------------------------------
# Any OpenAI-compatible endpoint. For a fully local setup, point this at
# Ollama (http://localhost:11434/v1) and leave LLM_API_KEY empty.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b

# ---- Open Government Data platform (data.gov.in) ------------------------
# ONE key covers every dataset on the platform; datasets are addressed by
# resource_id. Register free at https://www.data.gov.in/user/register and
# copy the key from your profile. Leave blank to skip this source.
DATA_GOV_IN_API_KEY=

# ---- Orchestration --------------------------------------------------------
PREFECT_API_URL=http://localhost:4200/api

# ---- Application ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
